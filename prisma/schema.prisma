generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  OWNER      @map("owner")
  ADMIN      @map("admin")
  EDITOR     @map("editor")
  ANALYST    @map("analyst")
  RESPONDENT @map("respondent")

  @@map("role_code")
}

enum SessionStatus {
  DRAFT       @map("draft")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  ABANDONED   @map("abandoned")
  EXPIRED     @map("expired")

  @@map("session_status")
}

enum AssetVisibility {
  PRIVATE  @map("private")
  INTERNAL @map("internal")
  PUBLIC   @map("public")

  @@map("asset_visibility")
}

enum TieBreakStrategy {
  FIRST_MATCH     @map("first_match")
  HIGHEST_Z_SCORE @map("highest_z_score")
  FLOWER_PRIORITY @map("flower_priority")

  @@map("tie_break_strategy")
}

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String            @unique(map: "users_email_key") @db.Text
  passwordHash      String?           @map("password_hash") @db.Text
  passwordUpdatedAt DateTime?         @map("password_updated_at") @db.Timestamptz(6)
  displayName       String?           @map("display_name") @db.Text
  avatarUrl         String?           @map("avatar_url") @db.Text
  profile           Json?             @db.JsonB
  lastLoginAt       DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  oauthAccounts     OAuthAccount[]
  refreshTokens     RefreshToken[]
  userRoles         UserRole[]
  responseSessions  ResponseSession[]
  assets            Asset[]           @relation("AssetCreatedBy")
  auditEntries      AuditLog[]        @relation("AuditActor")

  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model RefreshToken {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  familyId          String         @map("family_id") @db.Uuid
  tokenHash         String         @unique(map: "auth_refresh_tokens_token_hash_key") @map("token_hash") @db.Text
  userAgent         String?        @map("user_agent") @db.Text
  ipAddress         String?        @map("ip_address") @db.Text
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  rotatedAt         DateTime?      @map("rotated_at") @db.Timestamptz(6)
  lastUsedAt        DateTime?      @map("last_used_at") @db.Timestamptz(6)
  replacedByTokenId String?        @map("replaced_by_token_id") @db.Uuid
  metadata          Json?          @db.JsonB
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  previousTokens    RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, expiresAt], map: "auth_refresh_tokens_user_id_expires_at_idx")
  @@index([familyId, createdAt], map: "auth_refresh_tokens_family_id_created_at_idx")
  @@index([replacedByTokenId], map: "auth_refresh_tokens_replaced_by_token_id_idx")
  @@map("auth_refresh_tokens")
}

model Role {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        RoleCode   @unique(map: "roles_code_key")
  name        String     @db.Text
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "user_roles_user_id_role_id_key")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

model OAuthAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String    @db.Text
  providerAccountId String    @map("provider_account_id") @db.Text
  providerEmail     String?   @map("provider_email") @db.Text
  profile           Json?     @db.JsonB
  tokenSet          Json?     @map("token_set") @db.JsonB
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "oauth_accounts_provider_provider_account_id_key")
  @@index([userId], map: "oauth_accounts_user_id_idx")
  @@map("oauth_accounts")
}

model Survey {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String                 @db.Text
  /// Increment `version` whenever the questionnaire content, ordering, scoring,
  /// or interpretation catalog changes and old responses must stay reproducible.
  version          Int                    @db.SmallInt
  title            String                 @db.Text
  description      String?                @db.Text
  /// `algorithmVersion` pins the scoring pipeline for this survey revision.
  /// Persist the same value into `computed_results.algorithm_version`.
  algorithmVersion String                 @map("algorithm_version") @db.Text
  tieBreakStrategy TieBreakStrategy       @default(HIGHEST_Z_SCORE) @map("tie_break_strategy")
  isActive         Boolean                @default(false) @map("is_active")
  settings         Json?                  @db.JsonB
  publishedAt      DateTime?              @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  flowers          Flower[]
  scales           Scale[]
  questions        Question[]
  responseSessions ResponseSession[]
  computedResults  ComputedResult[]
  zLevels          ZLevel[]
  interpretations  FlowerInterpretation[]

  @@unique([code, version], map: "surveys_code_version_key")
  @@index([code, isActive], map: "surveys_code_is_active_idx")
  @@index([publishedAt], map: "surveys_published_at_idx")
  @@map("surveys")
}

model Flower {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId        String                 @map("survey_id") @db.Uuid
  code            String                 @db.Text
  title           String                 @db.Text
  description     String?                @db.Text
  sortOrder       Int                    @default(0) @map("sort_order") @db.SmallInt
  priority        Int                    @default(0) @db.SmallInt
  metadata        Json?                  @db.JsonB
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  survey          Survey                 @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  scales          Scale[]
  interpretations FlowerInterpretation[]
  primaryResults  ComputedResult[]       @relation("PrimaryFlower")

  @@unique([surveyId, code], map: "flowers_survey_id_code_key")
  @@index([surveyId, sortOrder], map: "flowers_survey_id_sort_order_idx")
  @@index([surveyId, priority], map: "flowers_survey_id_priority_idx")
  @@map("flowers")
}

model Scale {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId    String       @map("survey_id") @db.Uuid
  flowerId    String?      @map("flower_id") @db.Uuid
  code        String       @db.Text
  title       String       @db.Text
  description String?      @db.Text
  sortOrder   Int          @default(0) @map("sort_order") @db.SmallInt
  minScore    Int          @default(0) @map("min_score") @db.SmallInt
  maxScore    Int          @default(100) @map("max_score") @db.SmallInt
  metadata    Json?        @db.JsonB
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  survey      Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  flower      Flower?      @relation(fields: [flowerId], references: [id], onDelete: SetNull)
  questions   Question[]
  scores      ScaleScore[]
  zLevels     ZLevel[]

  @@unique([surveyId, code], map: "scales_survey_id_code_key")
  @@index([surveyId, sortOrder], map: "scales_survey_id_sort_order_idx")
  @@index([flowerId], map: "scales_flower_id_idx")
  @@map("scales")
}

model Question {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId        String   @map("survey_id") @db.Uuid
  scaleId         String   @map("scale_id") @db.Uuid
  code            String   @db.Text
  prompt          String   @db.Text
  helpText        String?  @map("help_text") @db.Text
  sortOrder       Int      @default(0) @map("sort_order") @db.SmallInt
  weight          Int      @default(1) @db.SmallInt
  minValue        Int      @default(1) @map("min_value") @db.SmallInt
  maxValue        Int      @default(5) @map("max_value") @db.SmallInt
  isRequired      Boolean  @default(true) @map("is_required")
  isReverseScored Boolean  @default(false) @map("is_reverse_scored")
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  scale           Scale    @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@unique([surveyId, code], map: "questions_survey_id_code_key")
  @@index([surveyId, sortOrder], map: "questions_survey_id_sort_order_idx")
  @@index([scaleId], map: "questions_scale_id_idx")
  @@map("questions")
}

model ResponseSession {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId          String          @map("survey_id") @db.Uuid
  userId            String?         @map("user_id") @db.Uuid
  status            SessionStatus   @default(DRAFT)
  clientFingerprint String?         @map("client_fingerprint") @db.Text
  metadata          Json?           @db.JsonB
  startedAt         DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  survey            Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers           Answer[]
  computedResult    ComputedResult?

  @@index([surveyId, status, startedAt], map: "response_sessions_survey_id_status_started_at_idx")
  @@index([userId, startedAt], map: "response_sessions_user_id_started_at_idx")
  @@map("response_sessions")
}

model Answer {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseSessionId String          @map("response_session_id") @db.Uuid
  questionId        String          @map("question_id") @db.Uuid
  valueSmallint     Int?            @map("value_smallint") @db.SmallInt
  valueText         String?         @map("value_text") @db.Text
  valueJson         Json?           @map("value_json") @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  responseSession   ResponseSession @relation(fields: [responseSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseSessionId, questionId], map: "answers_response_session_id_question_id_key")
  @@index([questionId], map: "answers_question_id_idx")
  @@map("answers")
}

model ComputedResult {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseSessionId String           @unique(map: "computed_results_response_session_id_key") @map("response_session_id") @db.Uuid
  surveyId          String           @map("survey_id") @db.Uuid
  primaryFlowerId   String?          @map("primary_flower_id") @db.Uuid
  /// Copy `surveys.algorithm_version` here at calculation time so historic
  /// reports remain reproducible even after future algorithm upgrades.
  algorithmVersion  String           @map("algorithm_version") @db.Text
  tieBreakStrategy  TieBreakStrategy @map("tie_break_strategy")
  resultPayload     Json             @map("result_payload") @db.JsonB
  computedAt        DateTime         @default(now()) @map("computed_at") @db.Timestamptz(6)
  responseSession   ResponseSession  @relation(fields: [responseSessionId], references: [id], onDelete: Cascade)
  survey            Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  primaryFlower     Flower?          @relation("PrimaryFlower", fields: [primaryFlowerId], references: [id], onDelete: SetNull)
  scaleScores       ScaleScore[]

  @@index([surveyId, computedAt], map: "computed_results_survey_id_computed_at_idx")
  @@index([primaryFlowerId], map: "computed_results_primary_flower_id_idx")
  @@map("computed_results")
}

model ScaleScore {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  computedResultId String         @map("computed_result_id") @db.Uuid
  scaleId          String         @map("scale_id") @db.Uuid
  zLevelId         String?        @map("z_level_id") @db.Uuid
  rawScore         Int            @map("raw_score") @db.SmallInt
  normalizedScore  Int?           @map("normalized_score") @db.SmallInt
  scoreRank        Int?           @map("score_rank") @db.SmallInt
  details          Json?          @db.JsonB
  computedResult   ComputedResult @relation(fields: [computedResultId], references: [id], onDelete: Cascade)
  scale            Scale          @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  zLevel           ZLevel?        @relation(fields: [zLevelId], references: [id], onDelete: SetNull)

  @@unique([computedResultId, scaleId], map: "scale_scores_computed_result_id_scale_id_key")
  @@index([scaleId], map: "scale_scores_scale_id_idx")
  @@index([zLevelId], map: "scale_scores_z_level_id_idx")
  @@map("scale_scores")
}

model ZLevel {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId        String                 @map("survey_id") @db.Uuid
  scaleId         String                 @map("scale_id") @db.Uuid
  code            String                 @db.Text
  label           String                 @db.Text
  description     String?                @db.Text
  zFrom           Int                    @map("z_from") @db.SmallInt
  zTo             Int                    @map("z_to") @db.SmallInt
  sortOrder       Int                    @default(0) @map("sort_order") @db.SmallInt
  metadata        Json?                  @db.JsonB
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  survey          Survey                 @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  scale           Scale                  @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  scaleScores     ScaleScore[]
  interpretations FlowerInterpretation[]

  @@unique([scaleId, code], map: "z_levels_scale_id_code_key")
  @@index([surveyId, scaleId, sortOrder], map: "z_levels_survey_id_scale_id_sort_order_idx")
  @@map("z_levels")
}

model FlowerInterpretation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId  String   @map("survey_id") @db.Uuid
  flowerId  String   @map("flower_id") @db.Uuid
  zLevelId  String?  @map("z_level_id") @db.Uuid
  code      String   @db.Text
  title     String   @db.Text
  summary   String   @db.Text
  narrative Json?    @db.JsonB
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  flower    Flower   @relation(fields: [flowerId], references: [id], onDelete: Cascade)
  zLevel    ZLevel?  @relation(fields: [zLevelId], references: [id], onDelete: SetNull)
  traits    Trait[]

  @@unique([surveyId, code], map: "flower_interpretations_survey_id_code_key")
  @@index([flowerId, zLevelId], map: "flower_interpretations_flower_id_z_level_id_idx")
  @@map("flower_interpretations")
}

model Trait {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flowerInterpretationId String               @map("flower_interpretation_id") @db.Uuid
  code                   String               @db.Text
  label                  String               @db.Text
  description            String?              @db.Text
  polarity               Int                  @default(0) @db.SmallInt
  sortOrder              Int                  @default(0) @map("sort_order") @db.SmallInt
  metadata               Json?                @db.JsonB
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  interpretation         FlowerInterpretation @relation(fields: [flowerInterpretationId], references: [id], onDelete: Cascade)

  @@unique([flowerInterpretationId, code], map: "traits_flower_interpretation_id_code_key")
  @@index([flowerInterpretationId, sortOrder], map: "traits_flower_interpretation_id_sort_order_idx")
  @@map("traits")
}

model Asset {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String          @map("entity_type") @db.Text
  entityId        String          @map("entity_id") @db.Uuid
  kind            String          @db.Text
  title           String?         @db.Text
  altText         String?         @map("alt_text") @db.Text
  storageKey      String          @map("storage_key") @db.Text
  publicUrl       String?         @map("public_url") @db.Text
  mimeType        String          @map("mime_type") @db.Text
  checksum        String?         @db.Text
  visibility      AssetVisibility @default(INTERNAL)
  metadata        Json?           @db.JsonB
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       User?           @relation("AssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, storageKey], map: "assets_entity_type_entity_id_storage_key_key")
  @@index([entityType, entityId], map: "assets_entity_type_entity_id_idx")
  @@index([visibility], map: "assets_visibility_idx")
  @@index([createdByUserId], map: "assets_created_by_user_id_idx")
  @@map("assets")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.Text
  entityType  String   @map("entity_type") @db.Text
  entityId    String   @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  metadata    Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Text
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt], map: "audit_log_entity_type_entity_id_created_at_idx")
  @@index([actorUserId, createdAt], map: "audit_log_actor_user_id_created_at_idx")
  @@map("audit_log")
}
