DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flower_survey
JWT_SECRET=replace-with-a-secure-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_STRUCTURED_LOGS=true
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
AUTH_BOOTSTRAP_ANALYST_EMAILS=analyst@example.com
BACKEND_ORIGIN=http://127.0.0.1:4000
OAUTH_CLIENT_ID=placeholder-client-id
OAUTH_CLIENT_SECRET=placeholder-client-secret
OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback
